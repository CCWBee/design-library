{
  "fontSize": ["12px", "13px", "15px", "17px", "22px", "16px"],
  "spacing": ["0", "0px", "1px", "2px", "3px", "4px", "8px", "12px", "16px", "24px", "32px", "auto"],
  "radius": ["20px", "12px", "999px", "50%", "inherit", "0", "0px", "4px"],
  "fontWeight": ["400", "600", "700", "normal", "inherit"],
  "colour": "^(var\\(--[\\w-]+\\)|transparent|currentColor|inherit|none|#fff|#ffffff|rgba\\(255,\\s*255,\\s*255,\\s*[\\d.]+\\))$",
  "shadow": ["none", "var(--sh-sheet)"],
  "easing": ["var(--e-out)"],
  "ignore": ["tokens.css"],
  "flags": {
    "backdropFilter": true,
    "uppercase": true,
    "tracking": true,
    "easing": true,
    "gradient": true,
    "endlessMotion": true
  }
}
